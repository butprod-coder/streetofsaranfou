<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Explicitly opaque: some firmware makes DeviceDefault translucent, leaving the TV app running under Home. -->
    <style name="HomeTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSwipeToDismiss">false</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:fontFamily">@font/outfit_regular</item>
    </style>

    <!-- Frosted pill button in the top bar -->
    <style name="Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:drawableTint">#FFFFFF</item>
        <item name="android:fontFamily">@font/outfit_regular</item>
        <item name="android:textColor">#F2F2F7</item>
        <item name="android:textSize">16sp</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
