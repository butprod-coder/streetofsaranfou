{
  "name": "streets-of-saranfou",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Beat'em up arcade solo et coopératif en ligne, dans les rues de Saran.",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:controller": "node tests/controller.mjs",
    "test:arcade": "node tests/arcade-browser.mjs",
    "test:talents": "node tests/talents-browser.mjs",
    "test:powers": "node tests/powers-browser.mjs",
    "test:music": "node tests/music-browser.mjs",
    "test:elites": "node tests/elites-browser.mjs",
    "test:classics": "node tests/classic-sprites-browser.mjs",
    "test:heroes": "node tests/heroes-browser.mjs",
    "test:hud": "node tests/hud-encore-browser.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs"
  },
  "dependencies": { "ws": "8.21.3" },
  "devDependencies": { "playwright": "^1.58.2" }
}
